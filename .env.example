# Copy to .env.local for local development (never commit real keys).
OPENAI_API_KEY=sk-proj-your-key-here

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: salt for hashing client IPs in audit logs
AUDIT_IP_SALT=change-me-to-a-random-string

# Admin secret for POST /api/ingest-pdf (PDF ingestion pipeline)
INGEST_ADMIN_SECRET=change-me-to-a-random-string
